# Sync with no machine file syncs no repo: it never takes the project
# around the working directory for the Brain.

cd proj
exec git clone -q . ../up
cd ../up
exec git commit -q --allow-empty -m ahead
cd ../proj
exec git remote add origin ../up
exec git fetch -q origin
exec git branch -q -u origin/main

! exec nerve sync --here

stderr 'error: no machine file at .*: run nerve init'
exec git rev-list --count HEAD
stdout '^1$'
