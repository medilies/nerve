# init refuses a folder that is not a Brain, and a machine file already
# there, which it never replaces.

! exec nerve init nowhere
stderr '/nowhere has no brain.toml: a Brain is a git repo with brain.toml at its top; make one there, or run nerve init on the folder that holds yours'
! exists $NERVE_CONFIG/config.toml

exec nerve init brain
cp $NERVE_CONFIG/config.toml $HOME/first
! exec nerve init brain
stderr 'config.toml exists: edit it instead'
cmp $NERVE_CONFIG/config.toml $HOME/first
