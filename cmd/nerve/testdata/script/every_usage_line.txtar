# Every usage line runs, and the usage keeps a line for each command run.

exec nerve init brain
cd proj

exec nerve project add app
stdout '^checkout .*/proj \(app\): listed'
exec nerve project ls
stdout '^project  app: lists nothing yet$'
exec nerve skill add go-stack
stdout '^added    skill go-stack to project app$'
exec nerve agent add reviewer
stdout '^added    agent reviewer to project app$'
exec nerve hook add fmt
stdout '^added    hook fmt to project app$'
exec nerve plugin add gopls@claude-plugins-official
stdout '^added    plugin gopls@claude-plugins-official'
exec nerve setting set model opus
stdout '^set      brain.json \(project app\): model = "opus"$'
exec nerve setting add permissions.deny Cron
stdout '^set      brain.json \(project app\): permissions.deny = \["Cron"\]$'
exec nerve setting set outputStyle terse --common
stdout '^set      brain.json \(common\): outputStyle = "terse"$'
mkdir ../brain/skills/tdd
cp ../tdd.md ../brain/skills/tdd/SKILL.md
exec nerve push 'add tdd'
stdout '^pushed   the Brain at [0-9a-f]{7}: add tdd$'
exec nerve sync --here
stdout '^synced   app'
exec nerve sync --here -f
stdout 'app is up to date'
exec nerve sync
stdout 'app is up to date'
exec nerve status
stdout '^project  app: 1 skill, 1 agent, 1 hook, 1 plugin, 2 settings$'
exec nerve check
stdout 'no problems'
exec nerve setting rm permissions.deny=Cron --all
stdout '^dropped  setting permissions.deny=Cron from project app$'
exec nerve setting rm outputStyle --common
stdout '^dropped  setting outputStyle from common$'
exec nerve setting rm model
stdout '^dropped  setting model from project app$'
exec nerve plugin rm gopls@claude-plugins-official
stdout '^dropped  plugin gopls@claude-plugins-official from project app$'
exec nerve hook rm fmt --all
stdout '^dropped  hook fmt from project app$'
exec nerve agent rm reviewer
stdout '^dropped  agent reviewer from project app$'
exec nerve skill rm go-stack
stdout '^dropped  skill go-stack from project app$'
! exec nerve update acme/up
stderr 'acme/up is not a source in brain.json'
exec nerve allow add statusLine
stdout '^allowed  statusLine$'
exec nerve allow rm statusLine
stdout '^dropped  statusLine from allowedSettings$'
exec nerve version
stdout '^nerve version '
exec nerve project rm app
stdout 'project  app: dropped from brain.json'

exec nerve help
stdout '^  init <brain> '
stdout '^  sync \[--here\] \[-f\] '
stdout '^  push \[<message>\] '
stdout '^  update \[<repo>\] \[--diff\] '
stdout '^  status '
stdout '^  check '
stdout '^  project add \[<name>\] '
stdout '^  project ls '
stdout '^  project rm <name> '
stdout '^  skill add\|rm <name> '
stdout '^  agent add\|rm <name> '
stdout '^  hook add\|rm <name> '
stdout '^  plugin add\|rm <plugin>@<marketplace> '
stdout '^  setting set <key> <value> '
stdout '^  setting add <key> <value> '
stdout '^  setting rm <key>\[=<value>\] '
stdout '^  allow add <key>\.\.\. '
stdout '^  allow rm <key>\.\.\. '
stdout '^  version, --version, -v '
stdout '^  help \[<command>\], --help, -h '
exec nerve help allow
stdout '^  allow add '

-- brain/brain.json --
{"hooks": {"fmt": {"event": "Stop", "command": "true"}}}
-- brain/skills/go-stack/SKILL.md --
---
name: go-stack
description: Does go-stack.
---
-- brain/agents/reviewer.md --
---
name: reviewer
description: Reviews.
---
-- tdd.md --
---
name: tdd
description: Tests first.
---
