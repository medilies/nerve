# A word that starts with one dash and a letter is a flag nerve does not
# know, not a name or a key; -- lets one through, and a negative number is
# a value, but not -inf or -nan.

exec nerve init brain
cd proj
exec nerve project add app

! exec nerve setting set -all model
stderr '-all is not a flag nerve knows: put -- before a word that starts with -'
! grep all $HOME/brain/brain.json

exec nerve setting set statusLine.padding -1
grep '^    "padding": -1$' $NERVE_CONFIG/overlays/app.json

! exec nerve setting set cleanupPeriodDays -inf
stderr '-inf is not a flag nerve knows: put -- before a word that starts with -'

# -f is a flag: a value -f goes after --.
! exec nerve setting set outputStyle -f
stderr 'a value that starts with - goes after --'
exec nerve setting set outputStyle -- -f
grep '^        "outputStyle": "-f"$' $HOME/brain/brain.json
! exec nerve skill add go-stack -f
stderr '^-f does not go with this command$'
