# Autosync prints a hook's output, asks Claude Code to rescan skills after
# linking one, and writes its own hook into the settings.

exec nerve init brain
cd proj
exec nerve project add app
exec nerve skill add go-stack

exec nerve sync --here --hook

stdout '"systemMessage":"nerve: .*linked   [^"]*/proj/.claude/skills/go-stack'
stdout '"hookSpecificOutput":\{"hookEventName":"SessionStart","reloadSkills":true\}'
grep ' sync --here --hook"' .claude/settings.local.json

-- brain/skills/go-stack/SKILL.md --
---
name: go-stack
description: Does go-stack.
---
