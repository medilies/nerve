# Sync fast-forwards the Brain from its upstream before it carries it.

exec nerve init brain
cd proj
exec nerve project add app
cd ../brain
exec git add -A
exec git commit -q -m a
exec git clone -q . ../up
cd ../up
exec git commit -q --allow-empty -m ahead
cd ../brain
exec git remote add origin ../up
exec git fetch -q origin
exec git branch -q -u origin/main

cd ../proj
exec nerve sync --here

stdout '^pulled '
exec git -C ../brain rev-list --count HEAD
stdout '^2$'
