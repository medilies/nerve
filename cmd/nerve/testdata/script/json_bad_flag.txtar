# --json, with any command line, prints one JSON document.

! exec nerve --json sync --bogus

! stderr .
stdout '^  "error": '
stdout '"error": "--bogus is not a flag nerve knows: put -- before a word that starts with -: nerve help lists the commands"'
! stdout 'usage: nerve'
! exec nerve --json frobnicate
stdout '"error": "nerve does not know this command line: frobnicate: nerve help lists the commands"'
! exec nerve --json setting set model
stdout '"error": "nerve does not know this command line: setting set model: nerve help lists the commands"'
