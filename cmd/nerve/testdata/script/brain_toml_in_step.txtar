# A command that changes brain.toml takes the remote's first, and refuses a
# Brain with changes to brain.toml not pushed, showing them; it changes
# nothing then. A push that would overwrite the remote's commits needs -f.

exec nerve init brain
cd proj
exec nerve project add app

# Another machine pushes a change.
exec git clone -q ../brain.git ../other
cd ../other
exec sh -c 'printf "[project.app]\nskills = [\"go-stack\"]\n" > brain.toml'
exec git commit -qam 'other machine'
exec git push -q
cd ../proj

exec nerve agent add reviewer
stdout '^synced   the Brain to [0-9a-f]{7}$'
stdout '^pushed   the Brain at [0-9a-f]{7}: nerve: add agent reviewer to project app$'
exec git -C ../brain.git show main:brain.toml
stdout 'skills = \["go-stack"\]'
stdout 'agents = \["reviewer"\]'

# brain.toml edited here, not pushed.
exec sh -c 'echo "[project.other]" >> ../brain/brain.toml'
! exec nerve setting set model opus
stdout '^\+\[project.other\]$'
stderr '^error: brain.toml has changes not pushed: nerve push sends them, nerve sync drops them$'
! grep model ../brain/brain.toml
! exec nerve --json setting set model opus
stdout '"error": "brain.toml has changes not pushed'

# Meanwhile the remote moves on: push refuses, -f overwrites.
cd ../other
exec git pull -q
exec git commit -q --allow-empty -m 'other again'
exec git push -q
cd ../proj
! exec nerve push 'add other'
stderr 'the remote has 1 commit \([0-9a-f]{7} other again\) this Brain lacks: .*nerve push -f overwrites them'
exec nerve push --force 'add other'
stdout '^pushed   the Brain at [0-9a-f]{7}: add other$'

-- brain/agents/reviewer.md --
---
name: reviewer
description: Reviews.
---
-- brain/skills/go-stack/SKILL.md --
---
name: go-stack
description: Does go-stack.
---
