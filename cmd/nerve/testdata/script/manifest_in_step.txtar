# A command that changes brain.json takes the remote's first, and refuses a
# Brain with changes to brain.json not pushed, showing them; it changes
# nothing then. A push that would overwrite the remote's commits needs -f.

exec nerve init brain
cd proj
exec nerve project add app

# Another machine pushes a change.
exec git clone -q ../brain.git ../other
cd ../other
exec sh -c 'printf "{\"projects\": {\"app\": {\"skills\": [\"go-stack\"]}}}\n" > brain.json'
exec git commit -qam 'other machine'
exec git push -q
cd ../proj

exec nerve agent add reviewer
stdout '^synced   the Brain to [0-9a-f]{7}$'
stdout '^pushed   the Brain at [0-9a-f]{7}: nerve: add agent reviewer to project app$'
exec git -C ../brain.git show main:brain.json
stdout '"skills": \[\n +"go-stack"\n +\]'
stdout '"agents": \[\n +"reviewer"\n +\]'

# brain.json edited here, not pushed.
replace ../brain/brain.json '"app": {' '"other": {}, "app": {'
! exec nerve setting set model opus
stdout '^\+    "other": \{\}, "app": \{$'
stderr '^error: brain.json in the Brain at .*/brain has changes not pushed\.$'
stderr '^Run one of these, then this command again:$'
stderr '^  nerve push                    commit every change in the Brain, and push it$'
stderr '^  nerve sync -f                 drop the Brain.s changes and commits not pushed$'
! grep model ../brain/brain.json

# Meanwhile the remote moves on, and the Brain has a commit of its own: push
# refuses, -f overwrites.
cd ../other
exec git pull -q
exec git commit -q --allow-empty -m 'other again'
exec git push -q
cd ../proj
exec git -C ../brain commit -qam 'mine'
! exec nerve push 'add other'
stderr 'the remote has 1 commit \([0-9a-f]{7} other again\) this Brain lacks\.$'
stderr '^  nerve push -f                 overwrite the remote.s commits with the Brain.s$'
exec nerve push --force 'add other'
stdout '^pushed   the Brain at [0-9a-f]{7}$'

-- brain/agents/reviewer.md --
---
name: reviewer
description: Reviews.
---
-- brain/skills/go-stack/SKILL.md --
---
name: go-stack
description: Does go-stack.
---
