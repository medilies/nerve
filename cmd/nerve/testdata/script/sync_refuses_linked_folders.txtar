# Sync refuses a tree where a folder or file nerve writes is a link, since
# it would write outside the tree; with --here, before the Brain changes.

exec nerve init brain
cd proj
exec nerve project add app
rm .claude/skills
mkdir $HOME/outside
symlink .claude/skills -> $HOME/outside
cp .claude/settings.local.json $WORK/before.json

! exec nerve sync --here
stderr '^error: .*/proj: .claude/skills is a link, so nerve would write outside the tree: make it a plain folder$'
! stdout .
! exec nerve sync
stdout '^problem  .*/proj: .claude/skills is a link, so nerve would write outside the tree: make it a plain folder$'
exec ls $HOME/outside
! stdout .
cmp .claude/settings.local.json $WORK/before.json
