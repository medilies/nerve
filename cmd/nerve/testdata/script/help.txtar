# help, and nerve alone, print the usage; an unknown flag prints it after
# the error.

exec nerve help
stdout '^usage: nerve <command>$'
! stderr .

exec nerve
stdout '^usage: nerve <command>$'
! stderr .

! exec nerve --bogus
! stdout .
stderr '^--bogus is not a flag nerve knows'
stderr '^usage: nerve <command>$'

# Output that is not a terminal has no colors.
env TERM=xterm-256color
exec nerve help
! stdout '\x1b'
