# help, and nerve alone, print the usage; an unknown flag prints it after
# the error.

exec nerve help
stdout '^usage: nerve <command>$'
! stderr .

exec nerve
stdout '^usage: nerve <command>$'
! stderr .

! exec nerve --bogus
! stdout .
stderr '^--bogus is not a flag nerve knows'
stderr '^usage: nerve <command>$'
