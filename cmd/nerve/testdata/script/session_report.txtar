# The session report says how the project stands, and changes nothing. Sync
# writes the hook that runs it, and that hook runs from anywhere in the
# project.

exec nerve init brain
cd proj
exec nerve project add app
grep '"command": "[^"]* status --hook"' .claude/settings.local.json
# From outside the checkout, which add would sync.
cd $WORK
exec nerve skill add go-stack --project app
cd proj
cp .claude/settings.local.json $WORK/before.json

exec nerve status --hook
stdout '^\{"systemMessage":"nerve: checkout [^"]*/proj \(app\): synced at [0-9a-f]{7}, behind the Brain at [0-9a-f]{7}; 1 change waits for nerve sync"\}$'
! exists .claude/skills/go-stack
cmp .claude/settings.local.json $WORK/before.json

exec nerve sync --here

mkdir src
cd src
exec sh -c 'eval "$(sed -n "s/.*\"command\": \"\(.*\)\",*$/\1/p" ../.claude/settings.local.json)"'
stdout '^\{"systemMessage":"nerve: checkout [^"]*/proj \(app\): synced at [0-9a-f]{7}"\}$'
! stderr .

-- brain/skills/go-stack/SKILL.md --
---
name: go-stack
description: Does go-stack.
---
