# update shows how a source's skills changed upstream: its pin and tip with
# their dates, and each skill's changed files, the whole diff only with
# --diff. Then it moves the pin to the tip, pushes it, and syncs the
# checkout here; a second update finds it there.

mkdir github/acme/up.git/skills/grilling
cp v1.md github/acme/up.git/skills/grilling/SKILL.md
cd github/acme/up.git
exec git init -q -b main
exec git config uploadpack.allowAnySHA1InWant true
exec git add -A
exec git commit -q -m v1
exec sh -c 'printf "{\"sources\": [{\"repo\": \"acme/up\", \"sha\": \"%s\", \"skills\": [\"grilling\"]}]}\n" "$(git rev-parse HEAD)" > $HOME/brain/brain.json'
cp $WORK/v2.md skills/grilling/SKILL.md
exec git commit -qam v2

cd $WORK/brain
exec git commit -qam 'add acme/up'
exec git push -q
cd $WORK
exec nerve init brain
cd proj
exec nerve project add app
exec nerve skill add grilling
exec nerve update

stdout '^tip      acme/up: pinned at [0-9a-f]{7} \(\d{4}-\d\d-\d\d\), tip [0-9a-f]{7} \(\d{4}-\d\d-\d\d\)$'
stdout '^changed  skill grilling: SKILL.md \+1 -0$'
! stdout 'Grill harder'
stdout '^pushed   the Brain at [0-9a-f]{7}: nerve: pin acme/up at [0-9a-f]{7}$'
stdout '^pinned   acme/up at [0-9a-f]{7}$'
stdout '^linked   .*/proj/.claude/skills/grilling -> '
stdout '^synced   app at [0-9a-f]{7} in .*/proj$'
exec sh -c 'grep -q "\"sha\": \"$(git -C $HOME/github/acme/up.git rev-parse HEAD)\"" $HOME/brain/brain.json'
exec sh -c 'test "$(git -C $HOME/brain rev-parse HEAD)" = "$(git -C $HOME/brain.git rev-parse main)"'
cd $WORK/brain

exec nerve update acme/up
stdout '^acme/up is already pinned at '

cp $WORK/v3.md $WORK/github/acme/up.git/skills/grilling/SKILL.md
exec git -C $WORK/github/acme/up.git commit -qam v3
exec nerve update --diff
stdout '^changed  skill grilling: SKILL.md \+1 -1$'
stdout '^\+Grill hardest\.$'

-- v1.md --
---
name: grilling
description: Grills.
---
-- v2.md --
---
name: grilling
description: Grills.
---
Grill harder.
-- v3.md --
---
name: grilling
description: Grills.
---
Grill hardest.
