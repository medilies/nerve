# update shows how a source's skills changed upstream, then moves the pin
# to its tip, pushes it, and syncs the checkout here; a second update finds
# it there.

mkdir github/acme/up.git/skills/grilling
cp v1.md github/acme/up.git/skills/grilling/SKILL.md
cd github/acme/up.git
exec git init -q -b main
exec git config uploadpack.allowAnySHA1InWant true
exec git add -A
exec git commit -q -m v1
exec sh -c 'printf "[[source]]\nrepo = \"acme/up\"\nsha = \"%s\"\nskills = [\"grilling\"]\n" "$(git rev-parse HEAD)" > $HOME/brain/brain.toml'
cp $WORK/v2.md skills/grilling/SKILL.md
exec git commit -qam v2

cd $WORK/brain
exec git commit -qam 'add acme/up'
exec git push -q
cd $WORK
exec nerve init brain
cd proj
exec nerve project add app
exec nerve skill add grilling
exec nerve update

stdout '\+Grill harder\.'
stdout '^pushed   the Brain at [0-9a-f]{7}: nerve: pin acme/up at [0-9a-f]{7}$'
stdout '^pinned   acme/up at [0-9a-f]{7}$'
stdout '^linked   .*/proj/.claude/skills/grilling -> '
stdout '^synced   app at [0-9a-f]{7} in .*/proj$'
exec sh -c 'grep -q "sha = \"$(git -C $HOME/github/acme/up.git rev-parse HEAD)\"" $HOME/brain/brain.toml'
exec sh -c 'test "$(git -C $HOME/brain rev-parse HEAD)" = "$(git -C $HOME/brain.git rev-parse main)"'
cd $WORK/brain

exec nerve update acme/up
stdout '^acme/up is already pinned at '

-- v1.md --
---
name: grilling
description: Grills.
---
-- v2.md --
---
name: grilling
description: Grills.
---
Grill harder.
