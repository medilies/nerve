# Outside the Brain and any listed checkout, check uses this machine's
# Brain, not a brain.toml found above the working directory.

exec nerve init brain
mkdir x
cd x

! exec nerve check

stdout 'skills/bad: frontmatter name "other" differs from folder name'

-- brain.toml --
nerve = "v9.9.9"
-- brain/skills/bad/SKILL.md --
---
name: other
description: x
---
